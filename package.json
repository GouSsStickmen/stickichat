{
  "name": "stickichat",
  "version": "0.5.12",
  "description": "Twitch chat client for moderators — multi-account, multi-chat, 7TV/BTTV/FFZ emotes",
  "main": "./out/main/index.js",
  "author": "Stickmen",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/GouSsStickmen/stickichat.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9222",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "vite build --config vite.mobile.config.ts && cap sync android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew assembleDebug",
    "mobile:run": "npm run mobile:sync && cap run android"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "emojibase-data": "^17.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.12.3",
    "unicode-emoji-json": "^0.9.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
